# Resolve REPLACE_SERVICE_USER/GROUP from actual capture unit, not old examples.
[Unit]
Description=KRYUK24 bounded Bro STAGING API
After=network.target
[Service]
Type=simple
User=REPLACE_SERVICE_USER
Group=REPLACE_SERVICE_GROUP
WorkingDirectory=/opt/kryuk24
ExecStart=/usr/bin/python3 /opt/kryuk24/bro_api.py --db /var/lib/kryuk24/runtime.sqlite --credentials /etc/kryuk24/bro-server.json --port 8789
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kryuk24
[Install]
WantedBy=multi-user.target
