# /etc/nginx/conf.d/kryuk24.conf; replace REPLACE_RUNTIME_HOST.
# Requires a real certificate BEFORE nginx -t / enabling this file.
# Direct public Nginx only: do not trust incoming X-Forwarded-For.
limit_req_zone $binary_remote_addr zone=kryuk_capture:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=kryuk_operator:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=kryuk_preview:10m rate=5r/s;
server {
 listen 80;
 server_name REPLACE_RUNTIME_HOST;
 location /.well-known/acme-challenge/ { root /var/www/acme; }
 location / { return 301 https://$host$request_uri; }
}
server {
 listen 443 ssl;
 server_name REPLACE_RUNTIME_HOST;
 ssl_certificate /etc/letsencrypt/live/REPLACE_RUNTIME_HOST/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/REPLACE_RUNTIME_HOST/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 access_log off;
 client_max_body_size 8k;
 proxy_connect_timeout 3s;
 proxy_read_timeout 10s;
 proxy_send_timeout 10s;
 proxy_set_header Host $host;
 proxy_set_header X-Forwarded-Proto https;
 location = /capture {
  limit_req zone=kryuk_capture burst=5 nodelay;
  limit_req_status 429;
  proxy_pass http://127.0.0.1:8788;
 }
 location = /contact-click {
  limit_req zone=kryuk_capture burst=5 nodelay;
  limit_req_status 429;
  proxy_pass http://127.0.0.1:8788;
 }
 location = /health { proxy_pass http://127.0.0.1:8788; }
 location /operator/site/ {
  limit_req zone=kryuk_preview burst=30 nodelay;
  limit_req_status 429;
  proxy_pass http://127.0.0.1:8788;
 }
 location /operator {
  limit_req zone=kryuk_operator burst=10 nodelay;
  limit_req_status 429;
  proxy_pass http://127.0.0.1:8788;
 }
 location / { return 404; }
}
